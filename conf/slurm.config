executor {
    name            = 'slurm'
    queueSize       = 50
    submitRateLimit = '10/1min'
}

process {
    executor       = 'slurm'
    queue          = 'general'
    clusterOptions = '-A r01340'

    withName: '.*DEEPVARIANT.*CALLVARIANTS.*' {
        queue            = 'h100-single'
        clusterOptions   = '-A r01340 --gres=gpu:1'
        containerOptions = '--nv'
        time             = { 24.h * task.attempt }
    }
}
